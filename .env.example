# Application
VITE_APP_NAME=NexaIQ
# Co-parent / partner logo (PNG) — shown next to the main logo in the sidebar
# Place your file in public/ and reference it here, e.g. /partner-logo.png
# VITE_PARTNER_LOGO_URL=/partner-logo.png

# Promo card artwork (transparent PNG) — defaults in src/assets/
# VITE_SIDEBAR_PROMO_IMAGE_URL=/images/sidebar-assistant-promo.png
# VITE_MULTI_AGENT_PROMO_IMAGE_URL=/images/multi-agent-promo.png
#
# Agent hero artwork (transparent PNG) — place in src/assets/:
#   data-issue-analyzer.png, impact-analyzer.png, knowledge-assistant.png,
#   ticket-analyzer.png, dqintelligence.png, costintelligence.png
VITE_API_BASE_URL=http://localhost:8000/api

# Agent chat API (appended to VITE_API_BASE_URL)
VITE_API_AGENT_CHAT_PATH=/chat
# Agent access list — GET /agents (applications derived from this response)
VITE_API_AGENTS_PATH=/agents
# Start conversation — POST {path} with user_id, application, agent_id
VITE_API_CONVERSATION_START_PATH=/history/conversations/start
# Conversation messages — POST (optional override; default /history/conversations/messages)
# VITE_API_CONVERSATION_MESSAGES_PATH=/history/conversations/messages
# Legacy (optional)
# VITE_API_CREATE_THREAD_PATH=/threads
# VITE_API_THREAD_MESSAGES_PATH=/history

# ── Demo auth (default for GitHub / local UI preview) ──
# true  = fake login/logout, no backend or SSO required
# false = real SSO + backend session (set OIDC values below)
VITE_MOCK_AUTH=true

# ── Mock API data (agent access list, conversation history) ──
# true  = use local mock data (GBICC, SMART EU agents)
# false = call real backend (e.g. on VDI)
VITE_MOCK_API=true
# When unset, mirrors VITE_MOCK_AUTH (demo mode uses local mocks).
# Uncomment to keep demo login but call the real backend on your VDI:
# VITE_MOCK_API=false
# POST /chat always uses the real backend (not gated by this flag).

# ── Real SSO (only when VITE_MOCK_AUTH=false) ──
# Change these in .env on your office VDI — no code changes needed.
VITE_OIDC_PROVIDER=entra
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/{tenant-id}/v2.0
VITE_OIDC_CLIENT_ID=your-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email offline_access

# Microsoft Entra ID (optional overrides when VITE_OIDC_PROVIDER=entra)
VITE_ENTRA_TENANT_ID=your-tenant-id
VITE_ENTRA_CLIENT_ID=your-client-id
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/{tenant-id}/v2.0

# Okta
VITE_OKTA_DOMAIN=https://your-org.okta.com
VITE_OKTA_CLIENT_ID=your-okta-client-id
VITE_OKTA_AUTHORITY=https://your-org.okta.com/oauth2/default

# Keycloak
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-keycloak-client-id

# Auth0
VITE_AUTH0_DOMAIN=https://your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.example.com
